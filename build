#!/usr/bin/env python3
"""./build            build the site locally
   ./build "message"  commit sources and push; CI builds and deploys"""
import glob, html, os, re, subprocess, sys

SECTIONS = ["Writing", "Notes", "Experiments"]
SITE = "https://yusufimaadkhan.github.io"
SITE_NAME = "Unnecessary & Insufficient"
FONTS = ["/System/Library/Fonts/Menlo.ttc",                        # mac
         "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"]    # ubuntu CI

def field(src, name):
    m = re.search(rf'^{name}:\s*["\']?(.*?)["\']?\s*$', src, re.M)
    return m.group(1).strip() if m else ""

subprocess.run(["quarto", "render"], check=True)

def blurb(src):
    """front-matter description, else the first paragraph of the body"""
    if d := field(src, "description"):
        return d
    body = re.sub(r"^---\n.*?\n---\n", "", src, count=1, flags=re.S)
    for para in re.split(r"\n\s*\n", body):
        text = re.sub(r"\[\^[^\]]*\]|[*_`#>]|\[([^\]]*)\]\([^)]*\)", r"\1", para)
        text = " ".join(text.split())
        if text and not text.startswith("[^"):
            return text[:197] + "..." if len(text) > 200 else text
    return SITE_NAME

def card(page, title, left, right=""):
    """draw a 1200x630 preview image: centred title, footer text flush left/right"""
    from PIL import Image, ImageDraw, ImageFont
    font = next((f for f in FONTS if os.path.exists(f)), None)
    if not font:
        return None
    big, small = ImageFont.truetype(font, 64), ImageFont.truetype(font, 30)
    W, H, M = 1200, 630, 90
    im = Image.new("RGB", (W, H), "#ffffff")
    d = ImageDraw.Draw(im)
    lines, line = [], ""
    for word in title.split():                       # wrap to the column
        trial = (line + " " + word).strip()
        if d.textlength(trial, font=big) > W - 2 * M and line:
            lines.append(line); line = word
        else:
            line = trial
    lines.append(line)
    if len(lines) > 3:
        lines = lines[:3]; lines[-1] = lines[-1][:-1] + "\u2026"
    y = M + 40                                         # title sits a touch lower
    for l in lines:
        d.text(((W - d.textlength(l, font=big)) / 2, y), l, font=big, fill="#2f2d2c"); y += 80
    if os.path.exists("_card-bg.png"):                 # tessellated Peirce graticule,
        bg = Image.open("_card-bg.png").convert("RGB")  # faded out at title and footer
        top, bot, ramp = y, H - M - 10, 150
        mid = (top + bot) / 2                           # shift so a mirror line of the
        off = mid - 75 * -(-mid // 75)                  # pattern (every 75px) sits at mid
        ease = lambda t: t * t * (3 - 2 * t)             # smoothstep
        mask = Image.new("L", (1, bg.height))
        mask.putdata([int(255 * ease(max(0, min(1, (k + off - top) / ramp, (bot - k - off) / ramp))))
                      for k in range(bg.height)])
        im.paste(bg, (0, round(off)), mask.resize((W, bg.height)))
    d.text((M, H - M - 10), left, font=small, fill="#494746")
    d.text((W - M - d.textlength(right, font=small), H - M - 10), right, font=small, fill="#494746")
    os.makedirs("cards", exist_ok=True)
    out = "cards/" + page.removesuffix(".html").replace("/", "-") + ".png"
    im.save(out)
    return out

def add_preview(page, title, description, left, right="", kind="article"):
    """insert Open Graph / Twitter card tags so links unfurl on social media"""
    src = open(page).read()
    if 'property="og:title"' in src:
        return
    e = html.escape
    url = SITE + "/" + page.removesuffix("index.html")
    tags = [
        f'<meta property="og:type" content="{kind}">',
        f'<meta property="og:site_name" content="{e(SITE_NAME)}">',
        f'<meta property="og:title" content="{e(title)}">',
        f'<meta property="og:url" content="{url}">',
    ]
    if description:
        tags += [f'<meta property="og:description" content="{e(description)}">',
                 f'<meta name="description" content="{e(description)}">']
    if img := card(page, title, left, right):
        tags += [f'<meta property="og:image" content="{SITE}/{img}">',
                 '<meta property="og:image:width" content="1200">',
                 '<meta property="og:image:height" content="630">',
                 '<meta name="twitter:card" content="summary_large_image">']
    else:
        tags += ['<meta name="twitter:card" content="summary">']
    tags = "\n".join(tags)
    src = src.replace("</title>", "</title>\n" + tags, 1)
    open(page, "w").write(src)

def markdown_entries(folder):
    for md in glob.glob(f"{folder}/*.md") + glob.glob(f"{folder}/*.qmd"):
        src = open(md).read()
        stem = md.rsplit(".", 1)[0]
        if not field(src, "description"):
            print(f"no description: {md}")
        add_preview(f"{stem}.html", field(src, "title") or md, blurb(src),
                    SITE_NAME, field(src, "date"))
        yield (field(src, "date"),
               field(src, "title") or md,
               field(src, "link") or f"{stem}.html")

def built_entries(folder):
    for page in glob.glob(f"{folder}/*/index.html"):
        src = open(page).read()
        t = re.search(r"<title>(.*?)</title>", src, re.S)
        d = re.search(r"<!--\s*date:\s*(.*?)\s*-->", src)
        yield (d.group(1) if d else "",
               html.unescape(t.group(1).strip()) if t else page,
               page.rsplit("/", 1)[0] + "/")

blocks = []
for label in SECTIONS:
    folder = label.lower()
    entries = list(built_entries(folder) if label == "Experiments"
                   else markdown_entries(folder))
    entries.sort(reverse=True)
    rows = "\n".join(
        f'<p><span class="d">{html.escape(d)}</span>'
        f'<a href="{h}">{html.escape(t)}</a></p>'
        for d, t, h in entries)
    blocks.append(f"<h2>{label}</h2>\n{rows}")

page = open("_index.html").read()
page = re.sub(r"<!-- notes:start -->\n.*?<!-- notes:end -->",
              "<!-- notes:start -->\n" + "\n\n".join(blocks) + "\n<!-- notes:end -->",
              page, flags=re.S)
open("index.html", "w").write(page)
add_preview("index.html", SITE_NAME, "", "yusufimaadkhan.github.io", kind="website")
print(f"index.html: {sum(b.count('<p>') for b in blocks)} entries")

if len(sys.argv) > 1:
    subprocess.run(["git", "add", "--",
                    "writing", "notes", "experiments",
                    "custom.css", "_index.html", "_back.html", "_quarto.yml", "_card-bg.png",
                    "build", ".github", ".gitignore", ".deployignore",
                    "README.md"], check=True)
    if subprocess.run(["git", "diff", "--cached", "--quiet"]).returncode == 0:
        sys.exit("nothing to commit")
    subprocess.run(["git", "commit", "-m", sys.argv[1]], check=True)
    subprocess.run(["git", "push"], check=True)
